# --- Gmail ---
# Download OAuth client credentials (Desktop app) from Google Cloud Console
# and save them as credentials.json in this folder.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
# Time window Gmail is searched in. WHICH emails are processed is decided by the Filters
# button in the app (allowed/blocked senders, subject words, attachment required).
# Use e.g. newer_than:30d once to back-fill older mail.
GMAIL_QUERY=newer_than:7d
# How often to check for new mail (seconds)
POLL_SECONDS=120

# --- AI extraction (optional but strongly recommended) ---
# Without a key the app falls back to a rule-based extractor (less accurate).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- App ---
DB_PATH=data/quotepo.db
# Folder-watch demo mode: files dropped here are processed like email attachments
INBOX_DIR=data/inbox
# Documents with overall confidence below this go to the review queue
REVIEW_THRESHOLD=0.80
